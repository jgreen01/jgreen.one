---
import rawSvg from '../assets/avatar.svg?raw';
import { parseAvatarSvg, avatarSvgAttributes } from '../utils/parseAvatarSvg';

const { attributes, innerHTML } = parseAvatarSvg(rawSvg);
const svgAttributes = avatarSvgAttributes(attributes, Astro.props);
---
<svg {...svgAttributes} set:html={innerHTML}></svg>
