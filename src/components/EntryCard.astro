---
/**
 * Props:
 * - entry: a single content collection entry
 */
import { type CollectionEntry } from "astro:content";
import { heroImagePath } from "../utils/heroImagePath";
import { formatDate } from "../utils/formatDate";
interface Props {
  entry: CollectionEntry<"entries">;
}
const { entry } = Astro.props;
const { data, collection } = entry;
const heroImage = heroImagePath(data.heroImage);
const href = `/${collection}/${entry.id}`;
---

<li class="mb-6">
  <div class="flex flex-col gap-2">
    <!-- Hero Image -->
    {heroImage && (
      <div class="w-full max-h-80 mb-2 hero-image-container overflow-hidden">
        {/*
          A mouse affordance only. The title link below points at the same
          entry, and two adjacent links to one destination make a screen reader
          announce it twice — so this one is hidden from assistive tech and
          skipped by the keyboard, and its image is decorative (empty alt)
          because the title already names the destination.
        */}
        <a href={href} tabindex="-1" aria-hidden="true" class="block h-full">
          <img
            src={heroImage}
            alt=""
            class="w-full h-full object-cover object-top rounded-lg transition-transform duration-300 hover:scale-[1.02]"
            loading="lazy"
            onerror="this.closest('.hero-image-container').style.display='none'"
          />
        </a>
      </div>
    )}

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <a href={href} class="text-xl font-semibold text-accent dark:text-accentDark hover:underline">
        {data.title}
      </a>
      <p class="text-sm text-muted-foreground dark:text-muted-foreground mt-1">
        <span class="capitalize">{collection}</span> &bull; {formatDate(data.pubDate)}
      </p>
      {data.description && <p class="text-foreground/80 dark:text-foregroundDark/80 mt-1">{data.description}</p>}
      <div class="flex flex-wrap gap-2 mt-2">
        {data.tags.map((tag) => <span class="text-xs font-semibold text-accent dark:text-accentDark bg-accent/10 dark:bg-accentDark/10 px-2 py-1 rounded-full">#{tag}</span>)}
      </div>
    </div>
  </div>
</li>
