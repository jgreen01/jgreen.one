---
import { getEntry, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import { profilePageJsonLd } from "../utils/structuredData";

// The prose lives in the `pages` collection so this page and its Markdown twin
// render from one source.
const about = await getEntry("pages", "about");
if (!about) throw new Error("src/content/pages/about.md is missing");
const { Content } = await render(about);
---
<PageLayout
  jsonLd={profilePageJsonLd()}
  title={`${about.data.title} — Jon Green`}
  description={about.data.description}
>
  <section class="prose dark:prose-invert">
    <h1>{about.data.title}</h1>
    <Content />
  </section>
</PageLayout>
