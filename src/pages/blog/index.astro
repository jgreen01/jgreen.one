---
import PageLayout from "../../layouts/PageLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getCollection } from "astro:content";
import { filterByKind, filterDrafts, sortByDate } from "../../utils/entries";
import { collectionPageJsonLd } from "../../utils/structuredData";
import { listingDescription } from "../../utils/pageDescription";

const posts = sortByDate(filterByKind(filterDrafts(await getCollection("entries")), "blog"));
const jsonLd = collectionPageJsonLd({
  name: "Blog",
  url: "/blog/",
  items: posts.map((entry) => ({ name: entry.data.title, url: `/entries/${entry.id}/` })),
});
---
<PageLayout title="Blog" description={listingDescription("blog", posts.length)} jsonLd={jsonLd}>
  <h1 class="text-4xl font-bold mb-4">Blog</h1>
  {posts.length === 0 ? (
    <p>No posts yet. Add files to <code>src/content/entries/</code> with <code>kind: "blog"</code>.</p>
  ) : (
    <ul class="list-none mt-8">
      {posts.map((entry) => <EntryCard entry={entry} />)}
    </ul>
  )}
</PageLayout>