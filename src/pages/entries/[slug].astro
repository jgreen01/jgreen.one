---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { filterDrafts } from "../../utils/entries";
import { breadcrumbJsonLd, entryJsonLd, graphJsonLd } from "../../utils/structuredData";

export async function getStaticPaths() {
  // Astro 6: entries expose `id`, not `slug`. The route param keeps the name
  // `slug` so the public URLs are unchanged — the value is the same string.
  const published = filterDrafts(await getCollection("entries"));
  return published.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// Astro 6: `entry.render()` was replaced by the standalone `render(entry)`.
const { Content } = await render(entry);
// Built here rather than in the layout: the canonical URL needs the entry id,
// which `entry.data` alone does not carry.
// The trail the reader sees and the trail in the markup are built from one
// array, so they cannot disagree.
const crumbs = [{ name: "Entries", url: "/entries/" }, { name: entry.data.title }];
const jsonLd = graphJsonLd([entryJsonLd(entry), breadcrumbJsonLd(crumbs)]);
---

<ArticleLayout frontmatter={entry.data} jsonLd={jsonLd} crumbs={crumbs}>
  <Content />
</ArticleLayout>
