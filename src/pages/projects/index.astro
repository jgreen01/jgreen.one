---
import PageLayout from "../../layouts/PageLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getCollection } from "astro:content";
import { filterByKind, filterDrafts, sortByDate } from "../../utils/entries";
import { collectionPageJsonLd } from "../../utils/structuredData";
import { listingDescription } from "../../utils/pageDescription";

const projects = sortByDate(
  filterByKind(filterDrafts(await getCollection("entries")), "project"),
);
const jsonLd = collectionPageJsonLd({
  name: "Projects",
  url: "/projects/",
  items: projects.map((entry) => ({ name: entry.data.title, url: `/entries/${entry.id}/` })),
});
---
<PageLayout title="Projects" description={listingDescription("projects", projects.length)} jsonLd={jsonLd}>
  <h1 class="text-4xl font-bold mb-4">Projects</h1>
  {projects.length === 0 ? (
    <p>No projects yet. Add files to <code>src/content/entries/</code> with <code>kind: "project"</code>.</p>
  ) : (
    <ul class="list-none mt-8">
  {projects.map((entry) => <EntryCard entry={entry} />)}
</ul>
  )}
</PageLayout>