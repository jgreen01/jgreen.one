---
import PageLayout from "../../layouts/PageLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { getCollection } from "astro:content";
import { filterByTag, filterDrafts, sortByDate, uniqueTags } from "../../utils/entries";

export async function getStaticPaths() {
  const published = filterDrafts(await getCollection("entries"));
  return uniqueTags(published).map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;
const published = filterDrafts(await getCollection("entries"));
const matches = sortByDate(filterByTag(published, String(tag)));
---
<PageLayout title={`Tag: ${tag}`}>
  <h1 class="text-4xl font-bold mb-4">Tag: {tag}</h1>
  {matches.length === 0
    ? <p>No entries found for this tag.</p>
    : matches.map((entry) => (
        <EntryCard entry={entry} />
      ))
  }
</PageLayout>